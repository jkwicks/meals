# secrets
.env

# python
venv/
__pycache__/
*.pyc

# generated at runtime — not source. All of it lands in data/ alongside the
# config it is generated from; week_plan_*.json covers "next" and any
# date-identified week the repository writes.
data/meal_history.json
# Measured weigh-ins and logged macros — accumulated by use, not source, and
# personal enough that it shouldn't ride along in a push. LocalJSONRepository
# treats a missing file as a cold start, so a fresh clone needs no seed copy.
data/biometrics.json
data/week_plan.json
data/week_plan_*.json
data/shopping_list.md
data/meals.log
data/nicegui.log
data/.nicegui.pid

# AI-assistant bundles, regenerated by ./scripts/prepare.sh from the sources they
# concatenate. Tracking them duplicated ~400KB of the repo into itself and
# meant every source edit produced a second, derived diff to review.
python_codebase.md
project_context.md
data_schemas.md

