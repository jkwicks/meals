# secrets
.env

# python
venv/
__pycache__/
*.pyc

# Written by the app, not by a person: week plans, history, measured
# biometrics, the shopping-list export. Ignored as a directory rather than
# file by file — if this needed a list of names it would mean data/ was still
# mixing hand-edited config with generated state, which is exactly what
# splitting config/ and reference/ out of it was for.
#
# recipes_master.json is the one exception, and it is a real one: the app
# writes it (favourites, imported recipes) but the contents are yours and
# worth keeping in history.
data/*
!data/recipes_master.json

# Logs and the server pidfile. Disposable in full; .gitkeep only exists so a
# fresh clone has the directory before anything tries to write into it.
logs/*
!logs/.gitkeep

# AI-assistant bundles, regenerated by ./scripts/prepare.sh from the sources they
# concatenate. Tracking them duplicated ~400KB of the repo into itself and
# meant every source edit produced a second, derived diff to review.
python_codebase.md
project_context.md
data_schemas.md

# local-only Claude Code settings
.claude/settings.local.json

# macOS
.DS_Store